local pBtn = Instance.new("TextButton", inner); style(pBtn, 1); pBtn.Text = "SELECT PLAYERS"
local pScroll = Instance.new("ScrollingFrame", inner)
pScroll.LayoutOrder = 2; pScroll.Size = UDim2.new(0.9, 0, 0, 80); pScroll.Visible = false
pScroll.BackgroundColor3 = Color3.new(0,0,0); pScroll.BackgroundTransparency = 0.5; pScroll.BorderSizePixel = 0
Instance.new("UIListLayout", pScroll)

local function updatePlayerButtonText()
	if selectedPlayers["ALL"] then 
		pBtn.Text = "SELECT: ALL"
		return 
	end
	local list = {}
	for name, _ in pairs(selectedPlayers) do table.insert(list, name) end
	if #list == 0 then
		pBtn.Text = "SELECT PLAYERS"
	elseif #list == 1 then
		pBtn.Text = "SEL: " .. list[1]
	else
		pBtn.Text = "SEL: " .. #list .. " players"
	end
end

local updatePlayersDropdown
updatePlayersDropdown = function()
	for _, c in ipairs(pScroll:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
	
	local function createOption(name)
		local b = Instance.new("TextButton", pScroll)
		b.Size = UDim2.new(1, 0, 0, 25)
		b.Text = (selectedPlayers[name] and "[X] " or "[  ] ") .. name
		b.TextColor3 = Color3.new(1,1,1); b.BackgroundTransparency = 0.8
		b.Font = "SourceSansBold"; b.TextSize = 14
		
		b.MouseButton1Click:Connect(function()
			if name == "ALL" then
				if selectedPlayers["ALL"] then
					selectedPlayers = {} 
				else
					selectedPlayers = { ["ALL"] = true } 
				end
			else
				selectedPlayers["ALL"] = nil 
				if selectedPlayers[name] then
					selectedPlayers[name] = nil 
					local playerObj = Players:FindFirstChild(name)
					if playerObj and playerObj.Character then
						resetPlayerParts(playerObj.Character) 
					end
				else
					selectedPlayers[name] = true 
				end
			end
			updatePlayerButtonText()
			updatePlayersDropdown()
		end)
	end
	
	createOption("ALL")
	for _, p in ipairs(Players:GetPlayers()) do 
		if p ~= localPlayer then createOption(p.Name) end 
	end
end

pBtn.MouseButton1Click:Connect(function() 
	pScroll.Visible = not pScroll.Visible
	if pScroll.Visible then updatePlayersDropdown() end
end)

