-- FUNÇÃO PARA RESETAR AS PARTES DE UM PLAYER
local function resetPlayerParts(char)
	if not char then return end
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local mesh = head and head:FindFirstChildOfClass("SpecialMesh")
	
	if head then
		head.Size = Vector3.new(2, 1, 1); head.Transparency = 0
		head.BrickColor = BrickColor.new("Medium stone grey")
		head.Material = Enum.Material.Plastic; head.CanCollide = true
		head.Massless = false; head.CustomPhysicalProperties = nil
	end
	if mesh then mesh.Scale = Vector3.new(1, 1, 1) end
	if torso then
		torso.Size = (torso.Name == "UpperTorso" and Vector3.new(2, 1, 1)) or Vector3.new(2, 2, 1)
		torso.Transparency = 0; torso.BrickColor = BrickColor.new("Medium stone grey")
		torso.Material = Enum.Material.Plastic; torso.CanCollide = true
		torso.Massless = false; torso.CustomPhysicalProperties = nil
	end
	if hrp then
		hrp.Size = Vector3.new(2, 2, 1); hrp.Transparency = 1
		hrp.BrickColor = BrickColor.new("Medium stone grey")
		hrp.Material = Enum.Material.Plastic; hrp.CanCollide = true
	end
end

local function resetAllParts()
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character then resetPlayerParts(p.Character) end
	end
end

